<Application x:Class="McTextureGhost.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom Typography from Google Fonts -->
            <FontFamily x:Key="FontSyne">./Resources/Fonts/#Syne, Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="FontPressStart2P">./Resources/Fonts/#Press Start 2P, Consolas, Courier New, monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
