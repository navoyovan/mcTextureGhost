<ui:FluentWindow x:Class="McTextureGhost.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:McTextureGhost.ViewModels"
        xmlns:views="clr-namespace:McTextureGhost.Views"
        xmlns:models="clr-namespace:McTextureGhost.Models"
        xmlns:controls="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/icon.ico"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />
        <views:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <views:IntGreaterThanZeroToVisibilityConverter x:Key="IntGreaterToVis" />
        <views:ImagePathConverter x:Key="ImagePathConverter" />

        <SolidColorBrush x:Key="GhostBrush" Color="#FC00FF" />
        <SolidColorBrush x:Key="OkBorderBrush" Color="#3c3c3c" />
        <SolidColorBrush x:Key="GhostBorderBrush" Color="#FC00FF" />

        <!-- TreeViewItem styling for dark theme -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#d4d4d8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <EventSetter Event="MouseDoubleClick" Handler="TreeViewItem_MouseDoubleClick" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3f3f46" />
                    <Setter Property="Foreground" Value="#ffffff" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#27272a" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- WinUI 3 Modern TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- WinUI 3 Top TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Height="36"
                     ApplicationTheme="Dark"
                     ButtonsForeground="#D0D0D0"
                     ButtonsBackground="Transparent"
                     Background="Transparent"
                     BorderBrush="#18FFFFFF"
                     BorderThickness="0,0,0,1">
            <ui:TitleBar.Header>
                <Grid Margin="8,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand Header: Icon + Name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,16,0">
                        <Border Width="22" Height="22" Background="#FC00FF" CornerRadius="4" Margin="0,0,8,0">
                            <TextBlock Text="👻" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="McTextureGhost" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Active Pack Indicator Badge (when pack is loaded) -->
                    <Border Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Height="26"
                            Background="#1E1A2B" BorderBrush="#8B5CF6" BorderThickness="1"
                            CornerRadius="6" Padding="8,2"
                            Visibility="{Binding IsPackLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#A78BFA" />
                            <TextBlock Text="{Binding PackName}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#E4E4E7" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Border Background="#FC00FF" CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding AllGhostCount, Converter={StaticResource IntGreaterToVis}}">
                                <TextBlock Text="{Binding AllGhostCount, StringFormat='👻 {0}'}"
                                           Foreground="#FFFFFF" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar -->
                <ColumnDefinition Width="270" MinWidth="220" MaxWidth="400" />
                <!-- Splitter -->
                <ColumnDefinition Width="2" />
                <!-- Main Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#26141417" BorderBrush="#27272a" BorderThickness="0,0,1,0">
            <Grid Margin="12,14,12,12">
                <Grid.RowDefinitions>
                    <!-- Pack Info Card -->
                    <RowDefinition Height="Auto" />
                    <!-- Section: Directory Explorer -->
                    <RowDefinition Height="*" />
                    <!-- Section: Quick Actions & Footer -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Pack Status Card -->
                <Border Grid.Row="0" Background="#1e1e22" BorderBrush="#2e2e34" BorderThickness="1"
                        CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Loaded Pack -->
                        <StackPanel Visibility="{Binding IsPackLoaded, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Pack Icon Button (Real or Ghost) -->
                                <Button Grid.Column="0" Command="{Binding OpenPackIconCommand}"
                                        Cursor="Hand" Margin="0,0,10,0" VerticalAlignment="Top"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Width="46" Height="46">
                                                <!-- Real Pack Icon -->
                                                <Border CornerRadius="6" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1"
                                                        SnapsToDevicePixels="True"
                                                        Visibility="{Binding HasPackIcon, Converter={StaticResource BoolToVis}}"
                                                        ToolTip="pack_icon.png (Click to open)">
                                                    <Grid>
                                                        <Image Source="{Binding PackIconPath, Converter={StaticResource ImagePathConverter}}"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               RenderOptions.EdgeMode="Aliased"
                                                               Margin="2" />
                                                        <Border x:Name="RealHoverOverlay" Background="#20FFFFFF" CornerRadius="5" Opacity="0" />
                                                    </Grid>
                                                </Border>

                                                <!-- Ghost Pack Icon -->
                                                <Border CornerRadius="6" Background="#1E1420" BorderBrush="#88F472B6" BorderThickness="1"
                                                        SnapsToDevicePixels="True"
                                                        Visibility="{Binding HasPackIcon, Converter={StaticResource InverseBoolToVis}}"
                                                        ToolTip="pack_icon.png is missing (Click to create placeholder)">
                                                    <Grid>
                                                        <TextBlock Text="?" FontSize="22" FontWeight="Bold"
                                                                   Foreground="#A0F472B6"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2"
                                                                Background="#55F472B6" CornerRadius="3" Padding="3,1">
                                                            <TextBlock Text="GHOST" FontSize="6.5" FontWeight="Bold" Foreground="#F472B6" />
                                                        </Border>
                                                        <Border x:Name="GhostHoverOverlay" Background="#20F472B6" CornerRadius="5" Opacity="0" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RealHoverOverlay" Property="Opacity" Value="1" />
                                                    <Setter TargetName="GhostHoverOverlay" Property="Opacity" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Pack Title Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ACTIVE RESOURCE PACK" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding PackName}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding PackRootPath}" />
                                    <TextBlock Text="{Binding PackRootPath}" FontSize="10" Foreground="#71717A"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" ToolTip="{Binding PackRootPath}" />
                                </StackPanel>
                            </Grid>

                            <!-- Counters -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Border Background="#2a2a30" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock FontSize="10" Foreground="#d4d4d8">
                                        <Run Text="{Binding TotalAliasCount, Mode=OneWay}" FontWeight="Bold" Foreground="White" />
                                        <Run Text="aliases" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#13382c" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                                    <TextBlock FontSize="10" Foreground="#34D399">
                                        <Run Text="{Binding TotalAddedCount, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="added" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#3b153b" CornerRadius="4" Padding="6,3">
                                    <TextBlock FontSize="10" Foreground="#FC00FF">
                                        <Run Text="{Binding TotalGhostCount, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="ghosts" />
                                    </TextBlock>
                                </Border>
                                <Border Background="#332410" CornerRadius="4" Padding="6,3" Margin="6,0,0,0"
                                        Visibility="{Binding TotalOrphanCount, Converter={StaticResource IntGreaterToVis}}">
                                    <TextBlock FontSize="10" Foreground="#F59E0B">
                                        <Run Text="{Binding TotalOrphanCount, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="orphans" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Mini actions -->
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="Explorer" Command="{Binding OpenInExplorerCommand}"
                                           Appearance="Secondary" Padding="8,4" FontSize="11" Margin="0,0,6,0">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Open24" FontSize="13" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Content="Rescan" Command="{Binding RescanCommand}"
                                           Appearance="Secondary" Padding="8,4" FontSize="11">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>

                            <!-- Missing Manifest Warning Banner in Pack Info Card -->
                            <Border Background="#2A1A10" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6"
                                    Padding="8,5" Margin="0,8,0,0"
                                    Visibility="{Binding HasManifest, Converter={StaticResource InverseBoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="⚠️ No manifest.json" FontWeight="SemiBold" FontSize="11" Foreground="#FBBF24" />
                                        <TextBlock Text="Folder lacks pack manifest" FontSize="9.5" Foreground="#D4D4D8" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1" Content="Generate" Command="{Binding SwitchToManifestViewCommand}"
                                               Appearance="Primary" Padding="8,3" FontSize="10" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- No Pack Loaded -->
                        <StackPanel Visibility="{Binding IsPackLoaded, Converter={StaticResource InverseBoolToVis}}">
                            <TextBlock Text="NO PACK LOADED" FontSize="9" FontWeight="Bold" Foreground="#71717a" Margin="0,0,0,4" />
                            <TextBlock Text="Select or create a pack to begin." FontSize="11" Foreground="#a1a1aa" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 2. Directory Explorer & Manifest Editor Section (Left Workspace) -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- View Toggle Header: Explorer vs Manifest -->
                    <Grid Grid.Row="0" Margin="0,0,0,8" Visibility="{Binding IsPackLoaded, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Explorer Tab Button -->
                        <ui:Button Grid.Column="0" Command="{Binding SwitchToExplorerViewCommand}"
                                   Padding="6,4" Margin="0,0,3,0" HorizontalAlignment="Stretch" Cursor="Hand">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#71717A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExplorerViewActive}" Value="True">
                                            <Setter Property="Appearance" Value="Secondary" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📁" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Explorer" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>

                        <!-- Manifest Tab Button -->
                        <ui:Button Grid.Column="1" Command="{Binding SwitchToManifestViewCommand}"
                                   Padding="6,4" Margin="3,0,0,0" HorizontalAlignment="Stretch" Cursor="Hand">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#71717A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsManifestViewActive}" Value="True">
                                            <Setter Property="Appearance" Value="Secondary" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="Manifest" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <!-- Missing indicator dot -->
                                <Border Width="6" Height="6" CornerRadius="3" Background="#F59E0B" Margin="5,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasManifest, Converter={StaticResource InverseBoolToVis}}"
                                        ToolTip="manifest.json is missing" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>

                    <TextBlock Grid.Row="0" Text="DIRECTORY EXPLORER" FontSize="10" FontWeight="SemiBold"
                               Foreground="#71717a" Margin="4,0,4,8"
                               Visibility="{Binding IsPackLoaded, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Folder TreeView when pack is loaded and Explorer is active -->
                    <TreeView Grid.Row="1" ItemsSource="{Binding PackFolders}"
                              SelectedItemChanged="TreeView_SelectedItemChanged"
                              Background="Transparent" BorderThickness="0"
                              Visibility="{Binding IsExplorerViewActive, Converter={StaticResource BoolToVis}}">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:PackFolderItem}" ItemsSource="{Binding SubFolders}">
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <TextBlock Text="{Binding Icon}" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#e4e4e7" VerticalAlignment="Center" />

                                    <!-- Missing Badge -->
                                    <Border Background="#4d2c00" CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="missing — click to generate" Foreground="#F59E0B" FontSize="9" FontWeight="Bold" />
                                    </Border>

                                    <!-- Total count badge (only for directories with textures) -->
                                    <Border Background="#27272a" CornerRadius="8" Padding="5,1" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding TextureCount, Converter={StaticResource IntGreaterToVis}}">
                                        <TextBlock Text="{Binding TextureCount}" Foreground="#888888" FontSize="9" />
                                    </Border>

                                    <!-- Ghost badge (only for directories with ghosts) -->
                                    <Border Background="#4d004d" CornerRadius="8" Padding="5,1" Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding GhostCount, Converter={StaticResource IntGreaterToVis}}">
                                        <TextBlock Text="{Binding GhostCount, StringFormat='👻 {0}'}"
                                                    Foreground="#FC00FF" FontSize="9" FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- Manifest Editor View (Left Workspace) -->
                    <Border Grid.Row="1" Background="#18181b" CornerRadius="8" BorderBrush="#27272a" BorderThickness="1"
                            Padding="10" Visibility="{Binding IsManifestViewActive, Converter={StaticResource BoolToVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding CurrentManifest}">
                                <!-- Header row with back button and status -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" Command="{Binding DataContext.SwitchToExplorerViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Appearance="Transparent" Padding="4,2" Margin="0,0,6,0" ToolTip="Back to Directory Explorer">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="13" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <TextBlock Grid.Column="1" Text="MANIFEST EDITOR" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#13382c" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FileExists}" Value="False">
                                                        <Setter Property="Background" Value="#332410" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="OK" />
                                                    <Setter Property="Foreground" Value="#34D399" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FileExists}" Value="False">
                                                            <Setter Property="Text" Value="MISSING" />
                                                            <Setter Property="Foreground" Value="#F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Notice when missing -->
                                <Border Background="#2a182a" BorderBrush="#88FC00FF" BorderThickness="1" CornerRadius="6"
                                        Padding="8,6" Margin="0,0,0,10"
                                        Visibility="{Binding FileExists, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="manifest.json does not exist yet. Values below are auto-filled and ready to generate."
                                               Foreground="#F472B6" FontSize="10" TextWrapping="Wrap" />
                                </Border>

                                <!-- Pack Name -->
                                <TextBlock Text="PACK NAME" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,3" />
                                <ui:TextBox Text="{Binding HeaderName, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Pack name" Margin="0,0,0,8" FontSize="11" />

                                <!-- Description -->
                                <TextBlock Text="DESCRIPTION" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,3" />
                                <ui:TextBox Text="{Binding HeaderDescription, UpdateSourceTrigger=PropertyChanged}"
                                            PlaceholderText="Description" TextWrapping="Wrap" AcceptsReturn="True"
                                            MinHeight="46" Margin="0,0,0,8" FontSize="11" />

                                <!-- Header UUID -->
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="HEADER UUID" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Command="{Binding DataContext.CopyHeaderUuidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Appearance="Transparent" Padding="3,1" ToolTip="Copy UUID">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="11" Foreground="#A1A1AA" />
                                        </ui:Button>
                                        <ui:Button Command="{Binding DataContext.RegenerateHeaderUuidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Appearance="Transparent" Padding="3,1" ToolTip="Generate new UUID">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="11" Foreground="#8B5CF6" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <ui:TextBox Text="{Binding HeaderUuid, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="Consolas" FontSize="10" Margin="0,0,0,8" />

                                <!-- Module UUID -->
                                <Grid Margin="0,0,0,3">
                                    <TextBlock Text="MODULE UUID" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Command="{Binding DataContext.CopyModuleUuidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Appearance="Transparent" Padding="3,1" ToolTip="Copy UUID">
                                            <ui:SymbolIcon Symbol="Copy24" FontSize="11" Foreground="#A1A1AA" />
                                        </ui:Button>
                                        <ui:Button Command="{Binding DataContext.RegenerateModuleUuidCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Appearance="Transparent" Padding="3,1" ToolTip="Generate new UUID">
                                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="11" Foreground="#8B5CF6" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <ui:TextBox Text="{Binding ModuleUuid, UpdateSourceTrigger=PropertyChanged}"
                                            FontFamily="Consolas" FontSize="10" Margin="0,0,0,8" />

                                <!-- Version row -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="VERSION" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,3" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding VersionMajor, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="10" Padding="2,3" />
                                            <TextBlock Grid.Column="1" Text="." Foreground="#71717A" VerticalAlignment="Center" Margin="2,0" />
                                            <ui:TextBox Grid.Column="2" Text="{Binding VersionMinor, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="10" Padding="2,3" />
                                            <TextBlock Grid.Column="3" Text="." Foreground="#71717A" VerticalAlignment="Center" Margin="2,0" />
                                            <ui:TextBox Grid.Column="4" Text="{Binding VersionPatch, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="10" Padding="2,3" />
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MIN ENGINE" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,0,0,3" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding MinEngineMajor, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="10" Padding="2,3" />
                                            <TextBlock Grid.Column="1" Text="." Foreground="#71717A" VerticalAlignment="Center" Margin="2,0" />
                                            <ui:TextBox Grid.Column="2" Text="{Binding MinEngineMinor, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="10" Padding="2,3" />
                                            <TextBlock Grid.Column="3" Text="." Foreground="#71717A" VerticalAlignment="Center" Margin="2,0" />
                                            <ui:TextBox Grid.Column="4" Text="{Binding MinEnginePatch, UpdateSourceTrigger=PropertyChanged}" HorizontalContentAlignment="Center" FontSize="10" Padding="2,3" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- Action Buttons -->
                                <StackPanel Margin="0,4,0,0">
                                    <!-- When exists: Save Changes -->
                                    <ui:Button Content="Save Changes"
                                               Command="{Binding DataContext.SaveManifestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Appearance="Primary" HorizontalAlignment="Stretch" Padding="8,5" Margin="0,0,0,6"
                                               Visibility="{Binding FileExists, Converter={StaticResource BoolToVis}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Save24" FontSize="13" />
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <!-- When missing: Generate manifest.json -->
                                    <ui:Button Content="Generate manifest.json"
                                               Command="{Binding DataContext.GenerateManifestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Appearance="Primary" HorizontalAlignment="Stretch" Padding="8,6" Margin="0,0,0,6"
                                               Visibility="{Binding FileExists, Converter={StaticResource InverseBoolToVis}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" />
                                        </ui:Button.Icon>
                                    </ui:Button>

                                    <ui:Button Content="Open in External Editor"
                                               Command="{Binding DataContext.OpenManifestInEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               Appearance="Secondary" HorizontalAlignment="Stretch" Padding="8,4" FontSize="10"
                                               Visibility="{Binding FileExists, Converter={StaticResource BoolToVis}}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Open24" FontSize="11" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Empty state placeholder when no pack is loaded -->
                    <Border Grid.Row="1" Background="#18181b" CornerRadius="6" BorderBrush="#222226" BorderThickness="1"
                            Padding="16" Visibility="{Binding IsPackLoaded, Converter={StaticResource InverseBoolToVis}}"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📂" FontSize="26" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.6" />
                            <TextBlock Text="No directory loaded" FontWeight="SemiBold" Foreground="#71717a"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Folders under textures/ will appear here once a pack is opened."
                                       TextWrapping="Wrap" Foreground="#52525b" FontSize="10" TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Quick Actions -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="#71717a" Margin="4,0,4,8" />
                    <ui:Button Content="Open Pack Folder..." Command="{Binding OpenPackFolderCommand}"
                               Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="10,7" Margin="0,0,0,4">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="Create New Pack..." Command="{Binding CreateNewPackCommand}"
                               Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="10,7" Margin="0,0,0,4">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderAdd24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="Close Pack" Command="{Binding ClosePackCommand}"
                               Appearance="Transparent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                               Padding="10,7"
                               Visibility="{Binding IsPackLoaded, Converter={StaticResource BoolToVis}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="15" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RESIZE SPLITTER -->
        <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="#27272a" ShowsPreview="False" />

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="2" Background="#CC0E0E0E">

            <!-- VIEW A: WELCOME SCREEN (when IsPackLoaded is false) -->
            <Grid Visibility="{Binding IsPackLoaded, Converter={StaticResource InverseBoolToVis}}" Margin="24">
                <!-- Top bar with Tutorial button -->
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                    <ui:Button Content="Tutorial &amp; Guide"
                               Command="{Binding OpenTutorialCommand}"
                               Appearance="Secondary"
                               ToolTip="Learn how MC Texture Ghost works">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="BookQuestionMark24" FontSize="14" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>

                <!-- Centered Hero Area -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="welcome" FontSize="44" FontWeight="Light" Foreground="#ffffff"
                               TextAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Ghost Resource Manager for Minecraft Bedrock"
                               FontSize="14" Foreground="#a1a1aa" TextAlignment="Center" Margin="0,0,0,36" />

                    <!-- Action Card 1: Open existing resource pack -->
                    <ui:CardAction Command="{Binding OpenPackFolderCommand}"
                                   Margin="0,0,0,16" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                    Background="#1E1A2B" BorderBrush="#8B5CF6" BorderThickness="1"
                                    Margin="0,0,16,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="FolderOpen24" FontSize="22" Foreground="#A78BFA" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Open existing resource pack" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#ffffff" Margin="0,0,0,2" />
                                <TextBlock Text="Point to your pack folder containing manifest.json"
                                           FontSize="12" Foreground="#8e8e93" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>

                    <!-- Action Card 2: Create new resource pack -->
                    <ui:CardAction Command="{Binding CreateNewPackCommand}"
                                   Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                    Background="#261026" BorderBrush="#FC00FF" BorderThickness="1"
                                    Margin="0,0,16,0" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="FolderAdd24" FontSize="22" Foreground="#FC00FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Create new resource pack" FontSize="15" FontWeight="SemiBold"
                                           Foreground="#ffffff" Margin="0,0,0,2" />
                                <TextBlock Text="Generate a fresh pack with manifest and JSON scaffolding"
                                           FontSize="12" Foreground="#8e8e93" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </ui:CardAction>
                </StackPanel>
            </Grid>

            <!-- VIEW B: ACTIVE PACK WORKSPACE (when IsPackLoaded is true) -->
            <DockPanel Visibility="{Binding IsPackLoaded, Converter={StaticResource BoolToVis}}" Margin="16">

                <!-- Top Toolbar -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
                    <!-- Category Tabs (All / Blocks / Items) -->
                    <Border VerticalAlignment="Center" Margin="0,0,14,0"
                            Background="#18181b" BorderBrush="#2e2e34" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <!-- All Tab -->
                            <ui:Button Command="{Binding SwitchToAllCommand}"
                                       Padding="10,5" FontSize="11" CornerRadius="5,0,0,5" Cursor="Hand"
                                       ToolTip="View all textures across terrain and items atlases">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#a1a1aa" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllTab}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                                <Setter Property="Foreground" Value="#ffffff" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="All" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="#25FFFFFF" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding AllGhostCount, Converter={StaticResource IntGreaterToVis}}">
                                        <TextBlock Text="{Binding AllGhostCount, StringFormat='👻 {0}'}"
                                                   FontSize="9" FontWeight="Bold" Foreground="#FC00FF" />
                                    </Border>
                                </StackPanel>
                            </ui:Button>

                            <!-- Blocks Tab -->
                            <ui:Button Command="{Binding SwitchToBlocksCommand}"
                                       Padding="10,5" FontSize="11" CornerRadius="0" Cursor="Hand"
                                       ToolTip="Filter to block textures (terrain_texture.json)">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#a1a1aa" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBlocksTab}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                                <Setter Property="Foreground" Value="#ffffff" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🧱" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Blocks" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="#25FFFFFF" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding BlocksGhostCount, Converter={StaticResource IntGreaterToVis}}">
                                        <TextBlock Text="{Binding BlocksGhostCount, StringFormat='👻 {0}'}"
                                                   FontSize="9" FontWeight="Bold" Foreground="#FC00FF" />
                                    </Border>
                                </StackPanel>
                            </ui:Button>

                            <!-- Items Tab -->
                            <ui:Button Command="{Binding SwitchToItemsCommand}"
                                       Padding="10,5" FontSize="11" CornerRadius="0,5,5,0" Cursor="Hand"
                                       ToolTip="Filter to item textures (item_texture.json)">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#a1a1aa" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsItemsTab}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                                <Setter Property="Foreground" Value="#ffffff" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🗡" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Items" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Background="#25FFFFFF" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding ItemsGhostCount, Converter={StaticResource IntGreaterToVis}}">
                                        <TextBlock Text="{Binding ItemsGhostCount, StringFormat='👻 {0}'}"
                                                   FontSize="9" FontWeight="Bold" Foreground="#FC00FF" />
                                    </Border>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- View Mode Tabs (Pack / Catalog) -->
                    <Border VerticalAlignment="Center" Margin="0,0,14,0"
                            Background="#18181b" BorderBrush="#2e2e34" BorderThickness="1" CornerRadius="6">
                        <StackPanel Orientation="Horizontal">
                            <!-- Pack View Tab -->
                            <ui:Button Command="{Binding SwitchToPackViewCommand}"
                                       Padding="10,5" FontSize="11" CornerRadius="5,0,0,5" Cursor="Hand"
                                       ToolTip="Pack View (Inspect your active resource pack)">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#a1a1aa" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPackView}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                                <Setter Property="Foreground" Value="#ffffff" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Grid24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Pack" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>

                            <!-- Catalog View Tab -->
                            <ui:Button Command="{Binding SwitchToCatalogViewCommand}"
                                       Padding="10,5" FontSize="11" CornerRadius="0,5,5,0" Cursor="Hand"
                                       ToolTip="Catalog View (Browse vanilla reference and add blocks)">
                                <ui:Button.Style>
                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                        <Setter Property="Appearance" Value="Transparent" />
                                        <Setter Property="Foreground" Value="#a1a1aa" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCatalogView}" Value="True">
                                                <Setter Property="Appearance" Value="Primary" />
                                                <Setter Property="Foreground" Value="#ffffff" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="List24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Catalog" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                Width="260" PlaceholderText="{Binding SearchPlaceholderText}"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                        <ui:TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding CommitSearchCommand}" />
                        </ui:TextBox.InputBindings>
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" FontSize="14" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>

                    <!-- Dropdown Filter with Checkboxes -->
                    <Grid VerticalAlignment="Center" Margin="0,0,14,0">
                        <ui:Button x:Name="StatusFilterButton"
                                   Click="StatusFilterButton_Click"
                                   Appearance="Secondary"
                                   Padding="10,6"
                                   Cursor="Hand">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Filter24" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FilterStatusLabel}" FontWeight="SemiBold" FontSize="11" Foreground="#E4E4E7" VerticalAlignment="Center" />
                                <TextBlock Text="▾" FontSize="10" Foreground="#A1A1AA" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>

                        <Popup x:Name="StatusFilterPopup"
                               PlacementTarget="{Binding ElementName=StatusFilterButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               Closed="StatusFilterPopup_Closed">
                            <Border Background="#1f1f23" BorderBrush="#3c3c3c" BorderThickness="1"
                                    CornerRadius="8" Padding="14,12" Width="230" Margin="0,4,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="FILTER BY STATUS" FontSize="10" FontWeight="Bold"
                                                   Foreground="#888888" VerticalAlignment="Center" />
                                        <ui:Button Content="Reset"
                                                   Command="{Binding ResetStatusFilterCommand}"
                                                   Appearance="Transparent"
                                                   Padding="6,2" FontSize="10"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}" />
                                    </Grid>

                                    <!-- Ghosts only checkbox -->
                                    <CheckBox IsChecked="{Binding GhostsOnly, Mode=TwoWay}"
                                              Margin="0,0,0,8" VerticalAlignment="Center" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#F472B6" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Ghosts only" Foreground="#E4E4E7" FontSize="12" VerticalAlignment="Center" />
                                            <Border Background="#3b153b" CornerRadius="8" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalGhostCount}" Foreground="#F472B6" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Already added checkbox -->
                                    <CheckBox IsChecked="{Binding AddedOnly, Mode=TwoWay}"
                                              Margin="0,0,0,8" VerticalAlignment="Center" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Already added" Foreground="#E4E4E7" FontSize="12" VerticalAlignment="Center" />
                                            <Border Background="#13382c" CornerRadius="8" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalAddedCount}" Foreground="#34D399" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Orphans checkbox -->
                                    <CheckBox IsChecked="{Binding OrphansOnly, Mode=TwoWay}"
                                              VerticalAlignment="Center" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Orphans" Foreground="#E4E4E7" FontSize="12" VerticalAlignment="Center" />
                                            <Border Background="#332410" CornerRadius="8" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TotalOrphanCount}" Foreground="#F59E0B" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Scanning indicator -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Scanning..." Foreground="#a1a1aa" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Active folder chip -->
                    <Border Background="#2f1c33" BorderBrush="#FC00FF" BorderThickness="1" CornerRadius="4"
                            Padding="8,3" VerticalAlignment="Center"
                            Visibility="{Binding SelectedFolder, Converter={StaticResource NullToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="12" Foreground="#A78BFA" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedFolderPath, Mode=OneWay}"
                                       Foreground="White" FontSize="11" VerticalAlignment="Center" />
                            <ui:Button Command="{Binding ClearFolderFilterCommand}"
                                       Appearance="Transparent" Padding="4,1" Margin="6,0,0,0" Cursor="Hand"
                                       ToolTip="Clear folder filter">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="10" Foreground="#FC00FF" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>

                    <!-- Vanilla Reference Status Badge & Refresh -->
                    <Border Margin="14,0,0,0" VerticalAlignment="Center"
                            Background="#18181b" BorderBrush="#2e2e34" BorderThickness="1" CornerRadius="6"
                            Padding="8,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:ProgressRing Width="12" Height="12" Margin="0,0,6,0"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsVanillaLoading, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding VanillaDataStatusLabel}" FontSize="10" Foreground="#A1A1AA" VerticalAlignment="Center" />
                            <ui:Button Command="{Binding FetchVanillaDataCommand}"
                                       Appearance="Transparent" Padding="4,1" Margin="6,0,0,0" Cursor="Hand"
                                       ToolTip="Re-check vanilla catalog from GitHub">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="11" Foreground="#A1A1AA" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status Bar -->
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                           Foreground="#8e8e93" Margin="0,10,0,0" FontSize="11" />

                <!-- "No match found" - Scaffolding creation panel -->
                <Border DockPanel.Dock="Top" Background="#232328" BorderBrush="#FC00FF" BorderThickness="1"
                        CornerRadius="6" Padding="14,12" Margin="0,0,0,12"
                        Visibility="{Binding ShowCreatePanel, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Foreground="White" Margin="0,0,0,8">
                            <Run Text="No alias named &quot;" />
                            <Run Text="{Binding SearchText, Mode=OneWay}" FontWeight="Bold" Foreground="#FC00FF" />
                            <Run Text="&quot; exists yet. Generate it as:" />
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="Plain block"
                                       Command="{Binding CreateTextureCommand}" CommandParameter="plain"
                                       Appearance="Primary" Margin="0,0,8,0"
                                       ToolTip="One texture, all faces. Most blocks." />
                            <ui:Button Content="Per-face block"
                                       Command="{Binding CreateTextureCommand}" CommandParameter="perface"
                                       Appearance="Secondary" Margin="0,0,8,0"
                                       ToolTip="Separate top / bottom / side textures, like a crate or log." />
                            <ui:Button Content="Flipbook (animated)"
                                       Command="{Binding CreateTextureCommand}" CommandParameter="flipbook"
                                       Appearance="Secondary"
                                       ToolTip="Animated sprite-sheet texture, like Prismarine." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Virtualized Tile Grid -->
                <ListBox ItemsSource="{Binding FilteredAliases}"
                         Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="{Binding IsPackView, Converter={StaticResource BoolToVis}}"
                         RenderOptions.BitmapScalingMode="NearestNeighbor"
                         RenderOptions.ClearTypeHint="Enabled"
                         SnapsToDevicePixels="True"
                         UseLayoutRounding="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:VirtualizingWrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Tag is set to the Window's DataContext (MainViewModel) so the ContextMenu
                                can reach VM commands through PlacementTarget.Tag (ContextMenu lives in a
                                separate visual tree where RelativeSource/AncestorType do not work).
                            -->
                            <Button Command="{Binding DataContext.EditTextureCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="6" Padding="0"
                                    Width="{Binding DataContext.TileButtonWidth,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    Height="{Binding DataContext.TileButtonHeight,
                                                     RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    ToolTip="{Binding UsedBySummary}" Cursor="Hand">

                                <!-- ── Context menu ───────────────────────────────────────────── -->
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open with editor"
                                                  Command="{Binding PlacementTarget.Tag.EditTextureCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Open containing folder"
                                                  Command="{Binding PlacementTarget.Tag.OpenTextureFolderCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Copy relative path"
                                                  Command="{Binding PlacementTarget.Tag.CopyPathCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="Register in terrain_texture.json"
                                                  Command="{Binding PlacementTarget.Tag.AddOrphanToJsonCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsBlockOrphan,
                                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                                       Converter={StaticResource BoolToVis}}" />
                                        <MenuItem Header="Register in item_texture.json"
                                                  Command="{Binding PlacementTarget.Tag.AddItemOrphanToJsonCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Visibility="{Binding PlacementTarget.DataContext.IsItemOrphan,
                                                                       RelativeSource={RelativeSource AncestorType=ContextMenu},
                                                                       Converter={StaticResource BoolToVis}}" />
                                        <Separator />
                                        <MenuItem Header="Reveal in sidebar"
                                                  Command="{Binding PlacementTarget.Tag.RevealInSidebarCommand,
                                                                    RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext,
                                                                             RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <!-- ── Card style (Fluent dark card with dashed or solid border and hover glow) ──── -->
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{Binding CardBackgroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{Binding CardBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                        <!-- Background border with 8px rounded corners -->
                                                        <Border x:Name="CardBg"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="8" />

                                                        <!-- Solid border: visible when NOT dashed (OK state) -->
                                                        <Border x:Name="SolidBorder"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8"
                                                                IsHitTestVisible="False"
                                                                Visibility="{Binding HasDashedBorder, Converter={StaticResource InverseBoolToVis}}" />

                                                        <!-- Dashed border: visible when dashed (Ghost, Orphan, NoEntry states) -->
                                                        <Rectangle x:Name="DashedBorder"
                                                                   Stroke="{TemplateBinding BorderBrush}"
                                                                   StrokeThickness="1"
                                                                   StrokeDashArray="3 3"
                                                                   RadiusX="8" RadiusY="8"
                                                                   Margin="0.5"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="{Binding HasDashedBorder, Converter={StaticResource BoolToVis}}" />

                                                        <!-- Hover highlight overlay (gentle violet glow) -->
                                                        <Border x:Name="HoverOverlay"
                                                                Background="#15FFFFFF"
                                                                BorderBrush="#8B5CF6"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                IsHitTestVisible="False"
                                                                Opacity="0" />

                                                        <!-- Card content centered -->
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>

                                <!-- ── Tile content ────────────────────────────────────────── -->
                                <StackPanel Margin="6">

                                    <!-- ── Top row: 7px Status dot + short text label (top-left) & Flipbook ANIM badge (top-right) ── -->
                                    <Grid Margin="0,0,0,5" Height="14">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="{Binding StatusDotBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{Binding StatusMutedBrush}"
                                                       FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Flipbook animation badge (top-right) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Background="#258B5CF6" CornerRadius="3" Padding="4,1"
                                                Visibility="{Binding IsFlipbook, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding FlipbookTooltip}">
                                            <TextBlock Text="ANIM" FontSize="8" FontWeight="Bold" Foreground="#A78BFA" />
                                        </Border>
                                    </Grid>

                                    <!-- ── Thumbnail area: pixel art thumbnail OR quiet glyph placeholder ── -->
                                    <Grid Width="{Binding DataContext.TileImageSize,
                                                          RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          Height="{Binding DataContext.TileImageSize,
                                                           RelativeSource={RelativeSource AncestorType=ListBox}}"
                                          SnapsToDevicePixels="True"
                                          UseLayoutRounding="True">

                                        <!-- Real texture thumbnail (for OK and Orphan): animated if flipbook, static if standard -->
                                        <views:FlipbookThumbnail Stretch="Uniform"
                                                                 RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                 RenderOptions.EdgeMode="Aliased"
                                                                 SnapsToDevicePixels="True"
                                                                 UseLayoutRounding="True"
                                                                 Visibility="{Binding ShowsImageThumbnail, Converter={StaticResource BoolToVis}}"
                                                                 Texture="{Binding}" />

                                        <!-- Quiet placeholder (for Ghost and NoEntry): dark recessed background + muted glyph -->
                                        <Border Background="{Binding PlaceholderBackgroundBrush}" CornerRadius="4"
                                                Visibility="{Binding ShowsPlaceholderGlyph, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="22" FontWeight="SemiBold"
                                                       Foreground="{Binding PlaceholderGlyphBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- ── Primary label: Clean Alias name, single-line with ellipsis ── -->
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center"
                                               Foreground="#F4F4F5"
                                               FontWeight="SemiBold"
                                               FontSize="11" Margin="0,4,0,0" />

                                    <!-- ── Single muted caption line: variant / face / orphan info ── -->
                                    <TextBlock Text="{Binding SubtitleCaption}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               TextAlignment="Center"
                                               Foreground="#71717A"
                                               FontSize="9" Margin="0,1,0,0"
                                               Visibility="{Binding SubtitleCaption, Converter={StaticResource StringNotEmptyToVis}}" />

                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Hierarchical Catalog Tree View (when IsCatalogView is true) -->
                <TreeView ItemsSource="{Binding FilteredCatalogTree}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsCatalogView, Converter={StaticResource BoolToVis}}">
                    <TreeView.Resources>
                        <!-- Level 1: BlockGroupNode -->
                        <HierarchicalDataTemplate DataType="{x:Type models:BlockGroupNode}"
                                                  ItemsSource="{Binding AliasGroups}">
                            <Border Margin="0,2" Padding="8,5" CornerRadius="6" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Block Icon + Display Name -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding IconGlyph}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding BlockId, StringFormat='{} ({0})'}" FontSize="10" Foreground="#71717A" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Badges & Action -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Ghost Badge -->
                                        <Border Background="#3b153b" CornerRadius="4" Padding="5,1" Margin="0,0,6,0"
                                                Visibility="{Binding HasGhost, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding GhostCount, StringFormat='{}👻 {0}'}"
                                                       FontSize="9" FontWeight="Bold" Foreground="#FC00FF" />
                                        </Border>

                                        <!-- Variants Count -->
                                        <Border Background="#202024" CornerRadius="4" Padding="5,1" Margin="0,0,8,0"
                                                Visibility="{Binding HasMultipleVariants, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding TotalVariants, StringFormat='{}{0} variants'}"
                                                       FontSize="9" Foreground="#A1A1AA" />
                                        </Border>

                                        <!-- 1-Click Add All Button -->
                                        <ui:Button Command="{Binding DataContext.AddVanillaEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Primary" Padding="8,3" FontSize="10"
                                                   Visibility="{Binding CanAddAll, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="Add this block and all its textures to your pack" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="+" FontWeight="Bold" FontSize="11" Margin="0,0,4,0" />
                                                <TextBlock Text="Add to Pack" FontSize="10" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>

                        <!-- Level 2: AliasGroupNode -->
                        <HierarchicalDataTemplate DataType="{x:Type models:AliasGroupNode}"
                                                  ItemsSource="{Binding Leaves}">
                            <Border Margin="2,1" Padding="6,3" CornerRadius="4" Background="#141417" BorderBrush="#222226" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔗" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.7" />
                                        <TextBlock Text="{Binding Alias}" FontSize="11" FontWeight="Medium" Foreground="#E4E4E7" VerticalAlignment="Center" />

                                        <!-- Face summary badge if any -->
                                        <Border Background="#258B5CF6" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                                Visibility="{Binding HasFaceSummary, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding FaceSummary}" FontSize="9" FontWeight="Bold" Foreground="#A78BFA" />
                                        </Border>

                                        <!-- Ghost count -->
                                        <Border Background="#3b153b" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                                Visibility="{Binding GhostCount, Converter={StaticResource IntGreaterToVis}}">
                                            <TextBlock Text="{Binding GhostCount, StringFormat='{}👻 {0}'}"
                                                       FontSize="9" FontWeight="Bold" Foreground="#FC00FF" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 1-Click Add Alias Button -->
                                    <ui:Button Grid.Column="1"
                                               Command="{Binding DataContext.AddVanillaEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                               CommandParameter="{Binding}"
                                               Appearance="Secondary" Padding="6,2" FontSize="9"
                                               Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"
                                               ToolTip="Add this alias to your pack" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="+" FontWeight="Bold" FontSize="10" Margin="0,0,3,0" />
                                            <TextBlock Text="Add Alias" FontSize="9" />
                                        </StackPanel>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>

                        <!-- Level 3: CatalogLeaf -->
                        <DataTemplate DataType="{x:Type models:CatalogLeaf}">
                            <Border Margin="4,1" Padding="6,3" CornerRadius="4" Background="#111114" BorderBrush="#1C1C20" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding StatusDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                                    <!-- Thumbnail or Placeholder -->
                                    <Grid Grid.Column="1" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Image Source="{Binding FullPath, Converter={StaticResource ImagePathConverter}}"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               RenderOptions.EdgeMode="Aliased"
                                               SnapsToDevicePixels="True"
                                               Visibility="{Binding ShowsImageThumbnail, Converter={StaticResource BoolToVis}}" />
                                        <Border Background="{Binding PlaceholderBackgroundBrush}" CornerRadius="3"
                                                Visibility="{Binding ShowsPlaceholderGlyph, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{Binding PlaceholderGlyphBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Relative Path & Caption -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="#D4D4D8" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SubtitleCaption, StringFormat='{} • {0}'}" FontSize="10" Foreground="#71717A" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        <Border Background="#258B5CF6" CornerRadius="3" Padding="3,1" Margin="6,0,0,0"
                                                Visibility="{Binding IsFlipbook, Converter={StaticResource BoolToVis}}"
                                                ToolTip="{Binding FlipbookTooltip}">
                                            <TextBlock Text="ANIM" FontSize="8" FontWeight="Bold" Foreground="#A78BFA" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Status badge & Actions -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusMutedBrush}"
                                                   FontSize="9" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />

                                        <ui:Button Command="{Binding DataContext.AddVanillaEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding}"
                                                   Appearance="Secondary" Padding="6,2" FontSize="9"
                                                   Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="Add this texture to your pack" Cursor="Hand">
                                            <TextBlock Text="+ Add" FontSize="9" />
                                        </ui:Button>

                                        <ui:Button Command="{Binding DataContext.EditTextureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   CommandParameter="{Binding TextureAlias}"
                                                   Appearance="Transparent" Padding="4,1" FontSize="9"
                                                   Visibility="{Binding TextureAlias, Converter={StaticResource NullToVis}}"
                                                   ToolTip="Open texture in image editor" Cursor="Hand">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Open24" FontSize="11" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>

            </DockPanel>
        </Grid>
    </Grid>
    </Grid>
</ui:FluentWindow>
