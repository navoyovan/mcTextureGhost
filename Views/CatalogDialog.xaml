<ui:FluentWindow x:Class="McTextureGhost.Views.CatalogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:McTextureGhost.ViewModels"
        xmlns:views="clr-namespace:McTextureGhost.Views"
        xmlns:models="clr-namespace:McTextureGhost.Models"
        Title="Bedrock Reference Catalog"
        Width="920" Height="700"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Background="#18181B"
        ShowInTaskbar="False">

    <Window.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVis" />
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <views:NullToVisibilityConverter x:Key="NullToVis" />
        <views:InverseNullToVisibilityConverter x:Key="InverseNullToVis" />
        <views:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
        <views:IntGreaterThanZeroToVisibilityConverter x:Key="IntGreaterToVis" />
        <views:ImagePathConverter x:Key="ImagePathConverter" />

        <!-- TreeViewItem styling for dark theme -->
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#D4D4D8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2D2D32" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#222226" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Firefox-style square caption buttons -->
        <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <!-- WinUI 3 Modern TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- Search & Category Filter Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Catalog Tree -->
            <RowDefinition Height="*" />
            <!-- Footer Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Height="40"
                     ApplicationTheme="Dark"
                     ButtonsForeground="#D0D0D0"
                     ButtonsBackground="#25FFFFFF"
                     Background="Transparent"
                     BorderBrush="#18FFFFFF"
                     BorderThickness="0,0,0,1">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Border Width="22" Height="22" Background="#8B5CF6" CornerRadius="4" Margin="0,0,8,0">
                        <TextBlock Text="📖" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Vanilla Bedrock Reference Catalog" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VanillaDataStatusLabel, StringFormat='{} • {0}'}" FontSize="11" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Search & Category Filter Toolbar -->
        <Border Grid.Row="1" Background="#141417" BorderBrush="#242428" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Search Input -->
                    <ColumnDefinition Width="*" />
                    <!-- Category Selector -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Sync Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <ui:TextBox Grid.Column="0"
                            Text="{Binding CatalogSearchText, UpdateSourceTrigger=PropertyChanged}"
                            PlaceholderText="Search vanilla blocks, items, or aliases (e.g. door, diamond, lantern)..."
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="#71717A" />
                    </ui:TextBox.Icon>
                </ui:TextBox>

                <!-- Category Selector: All | Blocks | Items -->
                <Border Grid.Column="1" Background="#1E1E22" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="All"
                                   Command="{Binding SetCatalogCategoryAllCommand}"
                                   Padding="14,5" FontSize="11.5" CornerRadius="5,0,0,5" Cursor="Hand">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#A1A1AA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCatalogAllCategory}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Content="Blocks"
                                   Command="{Binding SetCatalogCategoryBlocksCommand}"
                                   Padding="14,5" FontSize="11.5" CornerRadius="0" Cursor="Hand">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#A1A1AA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCatalogBlocksCategory}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <ui:Button Content="Items"
                                   Command="{Binding SetCatalogCategoryItemsCommand}"
                                   Padding="14,5" FontSize="11.5" CornerRadius="0,5,5,0" Cursor="Hand">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Appearance" Value="Transparent" />
                                    <Setter Property="Foreground" Value="#A1A1AA" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCatalogItemsCategory}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                            <Setter Property="Foreground" Value="#FFFFFF" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                    </StackPanel>
                </Border>

                <!-- Refresh / Sync Catalog Button -->
                <ui:Button Grid.Column="2" Command="{Binding FetchVanillaDataCommand}"
                           Appearance="Secondary" Padding="10,6" VerticalAlignment="Center"
                           ToolTip="Re-check vanilla catalog updates from Mojang GitHub">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
        </Border>

        <!-- Main Catalog TreeView -->
        <TreeView Grid.Row="2"
                  ItemsSource="{Binding FilteredCatalogTree}"
                  Background="Transparent" BorderThickness="0"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Padding="16,10">
            <TreeView.Resources>
                <!-- Level 1: BlockGroupNode -->
                <HierarchicalDataTemplate DataType="{x:Type models:BlockGroupNode}"
                                          ItemsSource="{Binding AliasGroups}">
                    <Border Margin="0,2" Padding="8,6" CornerRadius="6" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Block Icon + Display Name -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IconGlyph}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BlockId, StringFormat='{} ({0})'}" FontSize="10.5" Foreground="#71717A" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Badges & Action -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Ghost Badge -->
                                <Border Background="#3b153b" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                        Visibility="{Binding HasGhost, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding GhostCount, StringFormat='{}👻 {0}'}"
                                               FontSize="10" FontWeight="Bold" Foreground="#FC00FF" />
                                </Border>

                                <!-- Variants Count -->
                                <Border Background="#202024" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                        Visibility="{Binding HasMultipleVariants, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding TotalVariants, StringFormat='{}{0} variants'}"
                                               FontSize="10" Foreground="#A1A1AA" />
                                </Border>

                                <!-- 1-Click Add All Button -->
                                <ui:Button Command="{Binding DataContext.AddVanillaEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"
                                           Appearance="Primary" Padding="10,4" FontSize="11"
                                           Visibility="{Binding CanAddAll, Converter={StaticResource BoolToVis}}"
                                           ToolTip="Add this block and all its textures to your pack" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="+" FontWeight="Bold" FontSize="12" Margin="0,0,4,0" />
                                        <TextBlock Text="Add to Pack" FontSize="11" FontWeight="SemiBold" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </HierarchicalDataTemplate>

                <!-- Level 2: AliasGroupNode -->
                <HierarchicalDataTemplate DataType="{x:Type models:AliasGroupNode}"
                                          ItemsSource="{Binding Leaves}">
                    <Border Margin="2,1" Padding="8,4" CornerRadius="4" Background="#141417" BorderBrush="#222226" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔗" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Opacity="0.7" />
                                <TextBlock Text="{Binding Alias}" FontSize="11.5" FontWeight="Medium" Foreground="#E4E4E7" VerticalAlignment="Center" />

                                <!-- Face summary badge if any -->
                                <Border Background="#258B5CF6" CornerRadius="3" Padding="5,1" Margin="8,0,0,0"
                                        Visibility="{Binding HasFaceSummary, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding FaceSummary}" FontSize="9.5" FontWeight="Bold" Foreground="#A78BFA" />
                                </Border>

                                <!-- Ghost count -->
                                <Border Background="#3b153b" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                        Visibility="{Binding GhostCount, Converter={StaticResource IntGreaterToVis}}">
                                    <TextBlock Text="{Binding GhostCount, StringFormat='{}👻 {0}'}"
                                               FontSize="9.5" FontWeight="Bold" Foreground="#FC00FF" />
                                </Border>
                            </StackPanel>

                            <!-- 1-Click Add Alias Button -->
                            <ui:Button Grid.Column="1"
                                       Command="{Binding DataContext.AddVanillaEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                       CommandParameter="{Binding}"
                                       Appearance="Secondary" Padding="8,3" FontSize="10"
                                       Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"
                                       ToolTip="Add this alias to your pack" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="+" FontWeight="Bold" FontSize="11" Margin="0,0,3,0" />
                                    <TextBlock Text="Add Alias" FontSize="10" />
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </Border>
                </HierarchicalDataTemplate>

                <!-- Level 3: CatalogLeaf -->
                <DataTemplate DataType="{x:Type models:CatalogLeaf}">
                    <Border Margin="4,1" Padding="8,4" CornerRadius="4" Background="#111114" BorderBrush="#1C1C20" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Status dot -->
                            <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{Binding StatusDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />

                            <!-- Thumbnail or Placeholder -->
                            <Grid Grid.Column="1" Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Image Source="{Binding FullPath, Converter={StaticResource ImagePathConverter}}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       RenderOptions.EdgeMode="Aliased"
                                       SnapsToDevicePixels="True"
                                       Visibility="{Binding ShowsImageThumbnail, Converter={StaticResource BoolToVis}}" />
                                <Border Background="{Binding PlaceholderBackgroundBrush}" CornerRadius="3"
                                        Visibility="{Binding ShowsPlaceholderGlyph, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PlaceholderGlyph}" FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding PlaceholderGlyphBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Relative Path & Caption -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RelativePath}" FontSize="11" Foreground="#D4D4D8" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SubtitleCaption, StringFormat='{} • {0}'}" FontSize="10" Foreground="#71717A" Margin="4,0,0,0" VerticalAlignment="Center" />
                                <Border Background="#258B5CF6" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                                        Visibility="{Binding IsFlipbook, Converter={StaticResource BoolToVis}}"
                                        ToolTip="{Binding FlipbookTooltip}">
                                    <TextBlock Text="ANIM" FontSize="8.5" FontWeight="Bold" Foreground="#A78BFA" />
                                </Border>
                            </StackPanel>

                            <!-- Status badge & Actions -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusMutedBrush}"
                                           FontSize="9.5" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />

                                <ui:Button Command="{Binding DataContext.AddVanillaEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding}"
                                           Appearance="Secondary" Padding="8,3" FontSize="10"
                                           Visibility="{Binding CanAdd, Converter={StaticResource BoolToVis}}"
                                           ToolTip="Add this texture to your pack" Cursor="Hand">
                                    <TextBlock Text="+ Add" FontSize="10" />
                                </ui:Button>

                                <ui:Button Command="{Binding DataContext.EditTextureCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                           CommandParameter="{Binding TextureAlias}"
                                           Appearance="Transparent" Padding="4,2" FontSize="9"
                                           Visibility="{Binding TextureAlias, Converter={StaticResource NullToVis}}"
                                           ToolTip="Open texture in image editor" Cursor="Hand">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Open24" FontSize="12" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- Footer Bar -->
        <Border Grid.Row="3" Background="#141417" BorderBrush="#242428" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="15" Foreground="#A78BFA" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Target Resource Pack: " FontSize="12" Foreground="#A1A1AA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PackName}" FontFamily="{StaticResource FontPressStart2P}" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage, StringFormat='{}  •  {0}'}" FontSize="11.5" Foreground="#34D399" VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}" />
                </StackPanel>

                <ui:Button Grid.Column="1" Content="Done" Click="CloseButton_Click"
                           Appearance="Secondary" Padding="20,7" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
